PORT=3000
MONGODB_URI_BASE=mongodb://127.0.0.1:27017
MONGODB_DATABASE=command-center-ai-local-example
DCC_LOCAL_DEMO=0
NODE_ENV=development
# Local OAuth only: loopback HTTP origin with no path (for example http://127.0.0.1:3000).
# Production requires an HTTPS origin matching RAILWAY_PUBLIC_DOMAIN.
PUBLIC_URL=
# Railway supplies these at runtime; do not set them locally.
RAILWAY_PUBLIC_DOMAIN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_REVIEW_BOT_LOGIN=
GITHUB_REVIEW_BOT_START_MARKER=
GITHUB_REVIEW_BOT_DONE_MARKER=
RECONCILE_INTERVAL_MS=21600000
