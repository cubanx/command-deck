PORT=3000
DATABASE_PATH=./data/command-center.sqlite
DCC_LOCAL_DEMO=0
NODE_ENV=development
# Production only: HTTPS origin with no path, matching RAILWAY_PUBLIC_DOMAIN.
PUBLIC_URL=
# Railway supplies these at runtime; do not set them locally.
RAILWAY_PUBLIC_DOMAIN=
RAILWAY_VOLUME_MOUNT_PATH=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_REVIEW_BOT_LOGIN=
GITHUB_REVIEW_BOT_START_MARKER=
GITHUB_REVIEW_BOT_DONE_MARKER=
RECONCILE_INTERVAL_MS=21600000
