{
	"name": "command-center-ai",
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@types/bun": "latest",
		"@vitest/coverage-v8": "4.1.10",
		"crap-ts": "0.1.1",
		"typescript": "latest",
		"vitest": "4.1.10"
	},
	"license": "MIT",
	"private": true,
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"build:web": "bun src/web/build.ts",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check .",
		"dev": "NODE_ENV=development DCC_LOCAL_DEMO=1 bun --watch src/server.ts",
		"start": "bun src/server.ts",
		"test": "bun run build:web && vitest run",
		"test:coverage": "bun run build:web && vitest run --coverage",
		"check:crap": "bun run test:coverage && crap-ts score src --coverage-file coverage/unit/coverage-final.json --max 30 --limit 20",
		"quality": "bun run validate:all",
		"validate:all": "bun scripts/validate-all.ts",
		"typecheck": "bunx tsc --noEmit",
		"knowledge:check": "MEX_TELEMETRY=0 npx --yes mex-agent@0.7.0 check --stale-warn-days 75 --stale-error-days 90 --stale-warn-commits 1000000 --stale-error-commits 1000000",
		"test:mongo": "MONGODB_URI_BASE=${MONGODB_URI_BASE:?MONGODB_URI_BASE is required} MONGODB_DATABASE=command-center-test-$(bun -e 'console.log(crypto.randomUUID())') vitest run test/mongodb.test.ts",
		"seed:bindings": "bun src/seed-bindings.ts"
	},
	"type": "module",
	"dependencies": {
		"mongodb": "6.19.0"
	}
}
