{
  "name": "developer-command-center",
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "latest"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development DCC_LOCAL_DEMO=1 bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "test:mongo": "MONGODB_URI_BASE=${MONGODB_URI_BASE:?MONGODB_URI_BASE is required} MONGODB_DATABASE=dev-command-center-test-$(bun -e 'console.log(crypto.randomUUID())') bun test test/mongodb.test.ts",
    "seed:bindings": "bun src/seed-bindings.ts"
  },
  "type": "module",
  "dependencies": {
    "mongodb": "6.19.0"
  }
}
